---
# =============================================================================
# values-secret.yaml — LOCAL USE ONLY, NEVER COMMIT TO GIT
# =============================================================================
# Copy this file to values-secret.yaml and populate all fields before running
# the vault initialization playbook. The ansible/playbooks/vault_init.yml
# playbook reads this file and pushes secrets into HashiCorp Vault.
#
# Vault KV v2 path convention: secret/{prefix}/{name}
#   - secret/global/  — shared across all clusters
#   - secret/hub/     — hub cluster only
#   - secret/{fqdn}/  — specific managed cluster
# =============================================================================

# OpenShift pull secret (from console.redhat.com -> Downloads -> Pull Secret)
pull_secret:
  vault_path: "secret/global/pull-secret"
  fields:
    pullSecret: 'CHANGEME — paste full pull secret JSON here'

# SSH keypair for node access (public key embedded in install-config; private key
# for Ansible post-install access)
ssh_keys:
  vault_path: "secret/global/ssh-keys"
  fields:
    publicKey: "CHANGEME — ssh-rsa AAAA..."
    privateKey: |
      CHANGEME — -----BEGIN OPENSSH PRIVATE KEY-----
      ...
      -----END OPENSSH PRIVATE KEY-----

# iDRAC / BMC credentials
# Ansible-vault covers these for Ansible-side use (bare metal prep/install).
# They are also pushed to Vault here for any GitOps-driven Day 2 BMC operations.
bmc_credentials:
  vault_path: "secret/hub/bmc-credentials"
  fields:
    hub_node1_user: "CHANGEME"
    hub_node1_password: "CHANGEME"
    hub_node2_user: "CHANGEME"
    hub_node2_password: "CHANGEME"
    hub_node3_user: "CHANGEME"
    hub_node3_password: "CHANGEME"

# HTTP staging server credentials
http_server:
  vault_path: "secret/hub/http-server"
  fields:
    ip: "CHANGEME — 192.168.x.x"
    user: "CHANGEME"

# ArgoCD / GitOps repository credentials (if repo is private)
gitops_repo:
  vault_path: "secret/hub/gitops-repo"
  fields:
    username: "CHANGEME"
    password: "CHANGEME — GitHub PAT or password"
