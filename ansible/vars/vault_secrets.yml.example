---
# =============================================================================
# vault_secrets.yml.example — ANSIBLE-VAULT ENCRYPTED IN PRODUCTION
# =============================================================================
# This file documents the structure of ansible/vars/vault_secrets.yml, which
# must be created and encrypted before running any playbook:
#
#   ansible-vault create ansible/vars/vault_secrets.yml
#
# To edit an existing encrypted file:
#   ansible-vault edit ansible/vars/vault_secrets.yml
#
# To run playbooks with the vault:
#   ansible-playbook playbooks/site.yml --ask-vault-pass
#   ansible-playbook playbooks/site.yml --vault-password-file .vault_pass
#
# The encrypted file is safe to commit to git. The .vault_pass file and the
# plaintext contents are NOT — both are gitignored.
# =============================================================================

# OpenShift pull secret — single-line JSON from console.redhat.com
vault_pull_secret: 'CHANGEME'

# SSH public key embedded in install-config (for node access post-install)
vault_ssh_public_key: "CHANGEME ssh-rsa AAAA..."

# iDRAC / BMC credentials per hub node
vault_idrac_user_node1: "CHANGEME"
vault_idrac_password_node1: "CHANGEME"

vault_idrac_user_node2: "CHANGEME"
vault_idrac_password_node2: "CHANGEME"

vault_idrac_user_node3: "CHANGEME"
vault_idrac_password_node3: "CHANGEME"

# HTTP staging server
vault_http_server_ip: "CHANGEME 192.168.x.x"
vault_http_server_user: "CHANGEME"

# BIND TSIG key for dynamic DNS SRV record management (automated mode).
# Generate with: tsig-keygen -a hmac-sha256 acm-update-key
# Use the base64 secret value (the Secret: field from tsig-keygen output).
vault_dns_tsig_key_secret: "CHANGEME_base64_tsig_secret=="
